# ─────────────────────────────────────────────────────────────────────────────
# ENV-SPECIFIC CONFIG  (copy to .env and fill in values for your environment)
# Fixed values (AppName, AppVersion, default ports) live in
# src/config/common.go and are NOT loaded from this file.
# ─────────────────────────────────────────────────────────────────────────────

# Environment: dev | qa | prod  (default: dev)
APP_ENV=dev

# App port — overrides Common.DefaultPort (8080) if set
APP_PORT=8080

# Database — all required
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=gomvc_dev

# DB_PORT and DB_SSLMODE and DB_TIMEZONE are optional;
# they fall back to values in config/common.go.
# DB_PORT=5432
# DB_SSLMODE=disable
# DB_TIMEZONE=Asia/Kolkata

# External API — required
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_KEY=your-api-key

# EXTERNAL_API_TIMEOUT is optional; defaults to Common.APITimeout (30s).
# EXTERNAL_API_TIMEOUT=30

# JWT — required
JWT_SECRET=your-jwt-secret

# JWT_EXPIRY_HOURS is optional; defaults to Common.JWTExpiry (24h).
# JWT_EXPIRY_HOURS=24

# CORS — comma-separated allowed origins. Use * to allow all (dev default).
# Tighten this in staging/prod to your actual frontend origins.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# LOGS_TARGETS controls which log sinks are active (comma-separated).
# Allowed values: files, console
# Priority: call-time (logger.To(…)) → this env var → files (hard default)
# LOGS_TARGETS=files,console
LOGS_TARGETS=files
